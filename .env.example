# Copy this file to .env and fill it in. Never commit your .env.

# Required: the bot token from @BotFather
TOKEN=

# Your own Telegram user ID (ask @userinfobot). This account is the admin:
# it gets access requests and failure warnings.
CHAT_ID=

# Password for the web dashboard, at least 10 characters. Leave empty to turn the dashboard off.
ADMIN_PASSWORD=

# --- Optional, shown with their defaults ---
# Telegram user IDs that may use the bot without approval, comma-separated
#ALLOWED_IDS=
# New people need the admin's approval on the dashboard (0 = anyone may sign up)
#APPROVAL=1
# Seconds between Kleinanzeigen scans
#INTERVAL=600
# Searches per user (per site)
#MAX_LINKS=5
# Most people the bot serves
#MAX_USERS=50
# Most alerts sent per search in one scan
#MAX_PER_CYCLE=10
# Alerts are deleted from the chats after this many hours (0 = keep; Telegram's limit is 48)
#ALERT_HOURS=24
# Port the dashboard listens on inside the container
#DASHBOARD_PORT=8080

# --- Optional: eBay (ebay.de) through eBay's official Browse API ---
# Needs a free eBay developer account. eBay switches on once all three are set.
#EBAY_DATA_DIR=/data/ebay
#EBAY_APP_ID=
#EBAY_CERT_ID=
# Seconds between eBay scans
#EBAY_INTERVAL=300
